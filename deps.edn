;; GOOSE and MMS are BER on the wire. `org-ietf-asn1` (kotoba-lang) is a real
;; BER/DER codec that already exists in this workspace, so the only
;; dependency here is that one workspace-local git dep, not a second BER
;; codec. See `src/iec61850/data.cljc` and `src/iec61850/goose.cljc` for how
;; `asn1/implicit`, `asn1/integer`, `asn1/boolean*`, `asn1/bit-string`,
;; `asn1/octet-string` and their `-value` readers are reused for every
;; context-tagged field IEC 61850 puts on top of plain BER.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/org-ietf-asn1
        {:git/url "https://github.com/kotoba-lang/org-ietf-asn1.git"
         :git/sha "e106c53357cf6649f8d3185e68aba0c00470685f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
